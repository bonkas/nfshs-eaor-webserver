# --- Repo layout ---
# deploy/    - everything meant to actually run on a public server.
#              This is the ONLY folder that should ever be uploaded/
#              pushed publicly.
# local-dev/ - local testing/reverse-engineering only: personal packet
#              captures, real login-replay bytes, bulk extracted game
#              assets, offline test suite. NEVER upload this folder
#              anywhere public - it's excluded wholesale below.

local-dev/

# Runtime state generated by deploy/backend.py while running - not
# source, safe to lose/regenerate, never commit.
deploy/data/
deploy/hit_counter.txt
deploy/history.jsonl

__pycache__/
*.pyc
.venv/
.venv-*/
venv/
