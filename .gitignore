# --- Repo layout ---
# deploy/    - everything meant to actually run on a public server.
#              This is the ONLY folder that should ever be uploaded/
#              pushed publicly.
# local-dev/ - local testing/reverse-engineering only: personal packet
#              captures, real login-replay bytes, bulk extracted game
#              assets, offline test suite. NEVER upload this folder
#              anywhere public - it's excluded wholesale below.

local-dev/

# staging/ - a separate git worktree (branch `dev`), nested here just so
# it syncs via Nextcloud across machines. It's its own checkout with its
# own history, not a subfolder of this branch - never let `main` track
# it, or a careless `git add -A`/`git add .` here would sweep in
# whatever unfinished/private work is sitting on `dev`.
staging/

# server/ - the backup NPS server, new and unverified (started
# 2026-10-17). Same "nothing public until tested and ready" rule as
# everything else in this project - remove this line once a real
# milestone (e.g. login+lobby working end-to-end) is confirmed and
# the user's said it's ready to go public.
server/

# Runtime state generated by deploy/backend.py while running - not
# source, safe to lose/regenerate, never commit.
deploy/data/
deploy/hit_counter.txt
deploy/history.jsonl

__pycache__/
*.pyc
.venv/
.venv-*/
venv/
