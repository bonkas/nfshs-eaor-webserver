# NFSHS Online - systemd service (non-Docker Linux hosts).
# Assumes the contents of deploy/ are copied to /opt/nfshs and owned by
# a "nfshs" user - see README.md for the full install steps.
# State (history.jsonl, hit_counter.txt) lives in /opt/nfshs/data.

[Unit]
Description=NFSHS Online web server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nfshs
WorkingDirectory=/opt/nfshs
# Change the address/port here, e.g. run.py 127.0.0.1:9000
ExecStart=/usr/bin/python3 /opt/nfshs/run.py 0.0.0.0:8123
# Without this, Python buffers stdout when it is a pipe, so [backend]
# messages can take a long time to appear in journalctl.
Environment=PYTHONUNBUFFERED=1
# Site-specific settings (e.g. NFSHS_BACKGROUND_POLL) go in a drop-in
# file, /etc/systemd/system/nfshs-online.service.d/local.conf, so
# reinstalling this file never overwrites them - see README.md.
Restart=always
RestartSec=5

# Hardening: the service can only write inside /opt/nfshs
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/nfshs

[Install]
WantedBy=multi-user.target
